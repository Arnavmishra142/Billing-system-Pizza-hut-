# Copy this file to ".env" (same folder as server.js) and fill in real values.
# ".env" itself is git-ignored — it will NEVER be committed or force-pushed,
# so your real key stays off GitHub. This file (.env.example) has no real
# secrets in it and is safe to commit.
#
# After creating .env, just run:  node server.js
# dotenv loads it automatically — no `export` needed in Termux anymore.

GROQ_API_KEY=

# Optional — only needed if you use menu-image upload (Cloudinary):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
