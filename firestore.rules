// firestore.rules
// Deploy with: firebase deploy --only firestore:rules
//
// Identity model:
//  • Customers   — Anonymous Firebase Auth (bridge build, no Cloud Functions).
//                  UID = Firebase anonymous UID (random, per-device).
//                  Phone + name stored in customers/{+91XXXXXXXXXX}.
//                  When Fast2SMS DLT is approved and OTP is enabled:
//                    - Restore customerAuth Cloud Function
//                    - Remove the bridge allow-create rules marked "BRIDGE"
//                    - The DB structure (phoneVerified field) needs no migration
//  • Operators   — Anonymous Firebase Auth (local-PIN login).
//                  sign_in_provider == 'anonymous' is treated as operator.
//                  When operatorSignIn Cloud Function is deployed (billing added):
//                    - Swap to billingOperator custom-token claim
//                    - Remove the anonymous fallback in isOperator()
//  • Cloud Fns   — Admin SDK; bypass all rules automatically.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isOperator() {
      // Accepts either:
      //  • A custom-token session with the billingOperator claim (when
      //    operatorSignIn Cloud Function is deployed), OR
      //  • An anonymous Firebase Auth session (current local-PIN login flow).
      return request.auth != null
          && (request.auth.token.get('billingOperator', false) == true
              || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function isSameCustomer(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isOrderOwner() {
      return request.auth != null
          && resource.data.keys().hasAll(['customer'])
          && resource.data.customer.get('uid', '') == request.auth.uid;
    }

    // Status values an operator is allowed to write on an order.
    // 'completed' was added 2026-07-28: billing panel sets this when Bill & Settle
    // or Save & Exit is pressed so the customer's Active Orders view updates.
    function isAllowedStatusUpdate() {
      let allowed = ['accepted', 'dismissed', 'kot', 'completed'];
      return request.resource.data.keys().hasAll(['status'])
          && allowed.hasAny([request.resource.data.status]);
    }

    // ── pending_table_orders ──────────────────────────────────────────────────
    // Reads:    owning customer OR any operator
    // Creates:  BRIDGE — any authenticated user may create their own order
    //           (uid in customer.uid must match the caller's Auth UID).
    //           When Cloud Functions are restored: change create back to `if false`
    //           so only createCustomerOrder Cloud Function can write.
    // Updates:  operators only, status transitions they own (accept, dismiss, kot).
    match /pending_table_orders/{orderId} {
      allow read:   if isOrderOwner() || isOperator();
      // BRIDGE: direct browser write — remove when createCustomerOrder CF is live
      allow create: if request.auth != null
                    && request.resource.data.customer.get('uid', '') == request.auth.uid;
      allow update: if isOperator() && isAllowedStatusUpdate();
    }

    // ── customer_table_sessions ───────────────────────────────────────────────
    // Created & released exclusively by Cloud Functions (Admin SDK).
    match /customer_table_sessions/{customerUid} {
      allow read:           if isSameCustomer(customerUid) || isOperator();
      allow create, update: if false;
    }

    // ── table_locks ───────────────────────────────────────────────────────────
    match /table_locks/{tableId} {
      allow read:           if isOperator();
      allow create, update: if false;
    }

    // ── customers ─────────────────────────────────────────────────────────────
    // Keyed by normalised phone: customers/{+91XXXXXXXXXX}
    //
    // BRIDGE (no Cloud Functions):
    //  • Any authenticated (anonymous) user may READ to look up by phone.
    //    Trade-off: phone enumeration is possible if someone knows the format.
    //    Acceptable for a local restaurant POS — no sensitive financial data
    //    is exposed, only name + phoneVerified status.
    //  • Any authenticated user may CREATE their own profile — but only with
    //    phoneVerified: false (cannot self-issue a verified status).
    //  • UPDATE is operator-only (staff support edits).
    //
    // When customerAuth Cloud Function is restored:
    //  • Remove the allow read (anonymous) and allow create lines (marked BRIDGE).
    //  • Uncomment: allow read, write: if isOperator();
    match /customers/{phone} {
      // BRIDGE: lookup (screen 1) and registration (screen 3)
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.phoneVerified == false;
      // Operator support edits (e.g. fix a wrong name)
      allow update: if isOperator();
      allow delete: if false;
    }

    // ── customer_uid_map ──────────────────────────────────────────────────────
    // Written exclusively by Cloud Functions (Admin SDK). Not used in bridge build.
    match /customer_uid_map/{uid} {
      allow read, write: if false;
    }

    // ── menu_items ────────────────────────────────────────────────────────────
    match /menu_items/{itemId} {
      allow read:  if true;
      allow write: if isOperator();
    }

    // ── settings (pizza sizes, etc.) ──────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isOperator();
    }

    // ── sales_history ─────────────────────────────────────────────────────────
    match /sales_history/{docId} {
      allow read, write: if isOperator();
    }

    // ── tables ────────────────────────────────────────────────────────────────
    match /tables/{tableId} {
      allow read:  if true;
      allow write: if isOperator();
    }

    // ── expenses / daily_expenses ─────────────────────────────────────────────
    match /expenses/{docId}       { allow read, write: if isOperator(); }
    match /daily_expenses/{docId} { allow read, write: if isOperator(); }

    // ── customer_order_history ────────────────────────────────────────────────
    // Written by the billing panel (operator) when Bill & Settle / Save & Exit
    // completes an order that originated from the Customer Panel.
    // Read by the owning customer to populate their Order History tab.
    //
    // Structure:
    //   customer_order_history/{customerUid}/orders/{ORDER_timestamp}
    //     orderId, tableId, customerName, customerPhone, items[], total,
    //     completedAt (Timestamp), completionReason, orderedAt (ISO string)
    //
    // Added: 2026-07-28
    match /customer_order_history/{uid}/orders/{orderId} {
      // AI UPDATE [2026-07-28]: Write now allows both isOperator() AND isSameCustomer(uid).
      // isSameCustomer(uid) added so authenticated customers can write only their own
      // history (request.auth.uid must equal the {uid} path segment — no cross-customer
      // writes possible). isOperator() is preserved because syncCustomerOrderCompletion()
      // in js/cart.js writes from the billing panel's own anonymous auth session whose
      // UID differs from the customer's UID; removing isOperator() would deny that write
      // and break the order completion flow entirely.
      allow write: if isOperator() || isSameCustomer(uid);
      // Customer reads only their own history.
      allow read:  if isSameCustomer(uid);
    }

    // ── Catch-all ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
