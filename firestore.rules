// firestore.rules
// Deploy with: firebase deploy --only firestore:rules
//
// Identity model:
//  • Customers   — Firebase Custom Auth issued by customerAuth Cloud Function.
//                  UID = 'cust_' + E.164 digits (stable, derived from phone).
//                  Token carries { customerPhone } claim (server-issued).
//  • Operators   — Firebase Custom Auth via the operatorSignIn Cloud Function,
//                  which issues a token with claim { billingOperator: true }.
//  • Cloud Fns   — Admin SDK; bypass all rules automatically.
//
// Customer lookup / creation   → customerAuth Cloud Function only.
// Order creation & lock acq.   → createCustomerOrder Cloud Function only.
// Lock release                 → releaseTableLock Cloud Function only.
// Status updates (accept/kot)  → operators may call directly from the panel.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isOperator() {
      return request.auth != null
          && request.auth.token.get('billingOperator', false) == true;
    }

    function isSameCustomer(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isOrderOwner() {
      return request.auth != null
          && resource.data.keys().hasAll(['customer'])
          && resource.data.customer.get('uid', '') == request.auth.uid;
    }

    // Status values an operator is allowed to write on an order.
    // Cloud Functions write 'completed'; that path uses Admin SDK and bypasses rules.
    function isAllowedStatusUpdate() {
      let allowed = ['accepted', 'dismissed', 'kot'];
      return request.resource.data.keys().hasAll(['status'])
          && allowed.hasAny([request.resource.data.status]);
    }

    // ── pending_table_orders ──────────────────────────────────────────────────
    // • Reads:    owning customer OR any operator
    // • Creates:  DENIED — must go through createCustomerOrder Cloud Function
    // • Updates:  operators only, and only for status transitions they own
    //             (accept, dismiss, kot).  'completed' is set by releaseTableLock
    //             Cloud Function via Admin SDK (bypasses rules).
    match /pending_table_orders/{orderId} {
      allow read:   if isOrderOwner() || isOperator();
      allow create: if false;
      allow update: if isOperator() && isAllowedStatusUpdate();
    }

    // ── customer_table_sessions ───────────────────────────────────────────────
    // Created & released exclusively by Cloud Functions (Admin SDK).
    // Customers may read their own session so the UI can show the assigned table.
    // All browser writes are denied — Cloud Functions are the only writers.
    match /customer_table_sessions/{customerUid} {
      allow read:           if isSameCustomer(customerUid) || isOperator();
      allow create, update: if false;
    }

    // ── table_locks ───────────────────────────────────────────────────────────
    // One sentinel document per table: `table_locks/{tableId}`.
    // Exclusively written by createCustomerOrder and releaseTableLock Cloud
    // Functions via Admin SDK (bypasses rules).
    // Operators may read to display which tables are occupied.
    // Customers may NOT read — they receive the authoritative tableId in the
    // createCustomerOrder response instead.
    // All browser writes are denied.
    match /table_locks/{tableId} {
      allow read:           if isOperator();
      allow create, update: if false;
    }

    // ── customers ─────────────────────────────────────────────────────────────
    // Keyed by normalised phone: customers/{+91XXXXXXXXXX}
    // Customer lookup and creation must happen through the customerAuth Cloud
    // Function (Admin SDK).  No direct browser reads or writes are permitted —
    // not even by the customer who owns the profile.  This prevents enumeration
    // and ensures all identity decisions are made server-side.
    // Operators may read/write for support and manual correction purposes.
    match /customers/{phone} {
      allow read, write: if isOperator();
      // All customer browser access is denied; go through customerAuth callable.
    }

    // ── customer_uid_map ──────────────────────────────────────────────────────
    // Reverse-lookup map: customer_uid_map/{uid} → { phone }
    // Written exclusively by Cloud Functions (Admin SDK).
    // No browser reads or writes permitted — this is a server-internal index.
    match /customer_uid_map/{uid} {
      allow read, write: if false;
    }

    // ── menu_items ────────────────────────────────────────────────────────────
    match /menu_items/{itemId} {
      allow read:  if true;
      allow write: if isOperator();
    }

    // ── settings (pizza sizes, etc.) ──────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isOperator();
    }

    // ── sales_history ─────────────────────────────────────────────────────────
    match /sales_history/{docId} {
      allow read, write: if isOperator();
    }

    // ── tables ────────────────────────────────────────────────────────────────
    match /tables/{tableId} {
      allow read:  if true;
      allow write: if isOperator();
    }

    // ── expenses / daily_expenses ─────────────────────────────────────────────
    match /expenses/{docId}       { allow read, write: if isOperator(); }
    match /daily_expenses/{docId} { allow read, write: if isOperator(); }

    // ── Catch-all ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
